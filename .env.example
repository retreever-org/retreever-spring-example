# Retreever Example environment template
#
# Copy this file to .env for local development or configure these values in
# your deployment provider. Leave optional values blank when the behavior should
# stay disabled.

# Server
SERVER_PORT=9000

# Retreever Studio authentication
# Leave both blank to make Retreever Studio public.
RETREEVER_AUTH_USERNAME=
RETREEVER_AUTH_PASSWORD=

# Retreever Studio iframe embedding
# Leave blank to keep the default frame-ancestors policy.
# For the public demo, use:
# RETREEVER_FRAME_ANCESTORS=https://retreever.dev https://www.retreever.dev
RETREEVER_FRAME_ANCESTORS=

# Local development CORS
# Leave blank in public deployments.
# For local retreever-ui development, use:
# RETREEVER_DEV_ALLOW_CROSS_ORIGIN=http://localhost:5173
RETREEVER_DEV_ALLOW_CROSS_ORIGIN=
